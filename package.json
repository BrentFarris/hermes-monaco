{
  "name": "hermes-monaco",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "dev": "node scripts/dev.mjs",
    "package": "node scripts/package.mjs",
    "check": "npm run build && npm test && python -m pytest"
  },
  "dependencies": {
    "dompurify": "3.4.17",
    "marked": "14.0.0",
    "monaco-editor": "0.56.0"
  },
  "overrides": { "dompurify": "3.4.17" },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}
